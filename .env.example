# Copy this file to .env and fill in your values before running docker compose

# A long random string — run: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_string

# First admin account credentials (only seeded if no admin exists yet)
ADMIN_EMAIL=admin@local.home
ADMIN_PASSWORD=changeme

# Port the web UI is available on (default: 3000)
WEBUI_PORT=3000

# Set automatically by CasaOS — leave blank when running manually
AppID=consume
